{
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "files.eol": "\r\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "[csharp]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "files.insertFinalNewline": false,
        "files.eol": "\r\n"
    },
    "prettier.requireConfig": true,
    "prettier.configPath": ".prettierrc.cjs",
    "prettier.documentSelectors": ["**/*.cs"],
    "hidefiles.configurationType": "local",
    "hidefiles.globalConfig": {
        "profiles": [
            {
                "name": "Strict",
                "detail": "Hide everything not immediately required",
                "hidden": [
                    "$Default",
                    ".cursor/",
                    ".cursor/rules/",
                    "bin/",
                    "node_modules/",
                    "obj/",
                    "scripts/",
                    "streamerbot-points-wt-to-streamelements/",
                    "tools/",
                    ".editorconfig",
                    ".gitignore",
                    ".prettierignore",
                    ".prettierrc.cjs",
                    "Directory.Build.props",
                    "Directory.Build.props.user",
                    "Directory.Build.props.user.example",
                    "package-lock.json",
                    "package.json",
                    "prettier-plugin-sb-csharp.cjs",
                    "StreamerBot.csproj",
                    "docs/",
                    ".tmp/ext_dump/"
                ]
            },
            {
                "name": "Default",
                "detail": "",
                "description": "Test",
                "hidden": [".vscode/"]
            }
        ]
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        ".vscode/": true
    },
    "hidefiles.selectedProfile": "Default"
}
