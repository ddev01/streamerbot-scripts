<Project>
  <Import Project="Directory.Build.props.user" Condition="Exists('Directory.Build.props.user')" />

  <PropertyGroup>
    <StreamerBotPath Condition="'$(StreamerBotPath)' == '' and '$(STREAMERBOT_PATH)' != ''">$(STREAMERBOT_PATH)</StreamerBotPath>
    <StreamerBotPath Condition="'$(StreamerBotPath)' == ''">CHANGE_ME</StreamerBotPath>
  </PropertyGroup>
</Project>
